---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Page Not Found — Borina Keo"
  description="This page doesn't exist, but your next integration opportunity does."
  showLoader={false}
>
  <section id="not-found" class="chapter nf" data-scene="storm" data-tone="dark" data-chapter="404" data-label="Lost" data-lattice="computer" data-lattice-cx="0.72" data-lattice-rx="0.22" data-lattice-ry="0.4">
    <div class="wrap nf-inner">
      <p class="telemetry"><span class="ch">ERR.404</span> Route not found</p>
      <h1 class="t-display nf-heading">Even migrations hit a wrong path.</h1>
      <p class="t-body">This page doesn't exist. Your next integration program does.</p>
      <a href="/" class="btn">Back to the start</a>
    </div>
  </section>
</BaseLayout>

<style>
  .nf { min-height: 100svh; display: grid; align-items: center; }
  .nf-inner { display: grid; gap: 1.5rem; max-width: 40rem; }
  .nf-inner .btn { justify-self: start; }
  .nf-heading { font-size: clamp(2.2rem, 6vw, 5.5rem); }
</style>
