---
// ChapterWork.astro — CH.06. Case studies as a pinned horizontal track on desktop, stacked on mobile.
import ChartPairedRungs from "./charts/ChartPairedRungs.astro";
import Icon from "./Icon.astro";
const brand = (s: string): "microsoft" | null => /Dynamics|Power Automate|Azure/.test(s) ? "microsoft" : null;
const projects = [
  {
    title: "Autonomous supply-chain agent", system: "Agent harness · skills · workflows", ai: "Claude / GPT-4o",
    metric: "16", metricLabel: "processes automated end-to-end",
    outcome: "A multi-agent system with a custom harness, domain skills and multi-step planning: it manages demand signals, procurement triggers and ERP updates across Kohl & Frisch supply-chain operations.",
    github: "https://github.com/Bmee007", image: "/images/supply-chain.jpg", alt: "Distribution centre at dusk with trailers at the docks",
    chart: null,
  },
  {
    title: "LLM memory research · supply-chain context", system: "Episodic · semantic · working memory", ai: "Python · LLM APIs",
    metric: "13%", metricLabel: "forecast accuracy improvement",
    outcome: "Memory architectures (episodic recall, semantic knowledge graphs, working context) that ground forecasting agents in long-horizon operational history rather than a single session.",
    github: null, image: "/images/llm-memory.jpg", alt: "Abstract network of connected nodes",
    chart: { title: "Forecast accuracy, indexed", sub: "left ladder = before (100) · right = after · one rung = 5 points", groups: [{ label: "Forecast accuracy", before: 100, after: 113 }, { label: "Stockouts", before: 100, after: 86 }] },
  },
  {
    title: "Agent security research & implementation", system: "Prompt injection · trust boundaries", ai: "Red teaming · defence patterns",
    metric: "100%", metricLabel: "privilege-escalation attempts blocked",
    outcome: "Threat models unique to autonomous agents: injection via tool outputs, cross-agent trust escalation, authorisation boundaries. Defensive harness patterns that hold agent actions to least privilege.",
    github: "https://github.com/Bmee007", image: "/images/agent-security.jpg", alt: "Server room lit in blue",
    chart: null,
  },
];
---
<section
  id="projects" class="work"
  data-scene="deep" data-tone="dark" data-chapter="06" data-label="Work"
  data-lattice="off"
>
  <div class="work-head wrap">
    <p class="telemetry" data-scramble><span class="ch">CH.06</span> Work · case studies</p>
    <h2 class="t-display projects-heading" data-split>AI Integrations in production.</h2>
    <span class="work-meta t-mono" aria-hidden="true"><span id="projects-counter">01</span> / 0{projects.length} · scroll</span>
    <span id="projects-progress" class="work-progress" aria-hidden="true"></span>
  </div>

  <div class="work-viewport">
    <div id="projects-track" class="work-track">
      {projects.map((p, i) => (
        <article class="project-card case-panel">
          <span class="case-num" aria-hidden="true">0{i + 1}</span>
          <div class="case-media">
            <img src={p.image} alt={p.alt} loading="lazy" decoding="async" />
            <span class="case-cap t-mono" aria-hidden="true"><span>Case 0{i + 1}</span><span>{p.system}</span></span>
          </div>
          <div class="case-top">
            <span class="case-metric">{p.metric}</span>
            <span class="case-metric-label t-mono">{p.metricLabel}</span>
          </div>
          <div class="case-mid">
            <h3 class="case-title">{p.title}</h3>
            <div class="case-chips">
              <span class="project-chip t-mono">{brand(p.system) && <Icon name="microsoft" size={11} />}{p.system}</span>
              <span class="project-chip project-chip--ai t-mono">{brand(p.ai) && <Icon name="microsoft" size={11} />}{p.ai}</span>
            </div>
            <p class="project-outcome t-body">{p.outcome}</p>
            {p.chart && <ChartPairedRungs title={p.chart.title} sub={p.chart.sub} groups={p.chart.groups} max={125} rungStep={5} source={`Indexed · ${p.system}`} />}
          </div>
          <div class="case-foot">
            {p.github && (
              <a href={p.github} class="link-arrow" target="_blank" rel="noopener noreferrer" data-cursor="open">
                <Icon name="github" size={13} /> View on GitHub
                <span class="disc"><svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4"/></svg></span>
              </a>
            )}
          </div>
        </article>
      ))}
      <article class="project-card project-card--end case-panel">
        <span class="t-display end-label">More in<br/>the field.</span>
        <a href="#contact" class="btn">Start a conversation</a>
      </article>
    </div>
  </div>
</section>

<style>
  .work { position: relative; padding-top: clamp(6rem, 12vw, 10rem); padding-bottom: clamp(4rem, 8vw, 7rem); }
  @media (min-width: 900px) {
    .work { height: 100svh; padding-top: 6.8rem; padding-bottom: 3.2vh; display: grid; grid-template-rows: auto 1fr; overflow: hidden; }
    .work-viewport { min-height: 0; }
    .work-track { height: 100%; }
  }
  .work-head { position: relative; display: grid; gap: 1rem; padding-bottom: 2.5rem; }
  .projects-heading { font-size: clamp(2rem, 4vw, 4rem); max-width: 16ch; }
  .work-meta { display: none; position: absolute; right: var(--gutter); bottom: 3.4rem; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  @media (min-width: 900px) { .work-meta { display: block; } }
  .work-progress {
    display: none; position: absolute; right: var(--gutter); bottom: 2.5rem;
    width: 10rem; height: 1px; background: var(--ink); transform: scaleX(0); transform-origin: left;
  }
  @media (min-width: 900px) { .work-progress { display: block; } }

  .work-viewport { overflow: hidden; }
  .work-track {
    display: flex; flex-direction: column; gap: 0;
    padding: 0 var(--gutter);
  }
  @media (min-width: 900px) {
    .work-track { flex-direction: row; width: max-content; padding-left: var(--gutter); padding-right: calc(var(--gutter) + 6rem); }
  }

  .case-panel {
    position: relative;
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 1.1rem;
    padding: 2.5rem 0 3rem;
    border-top: 1px solid var(--line-2);
    min-height: 24rem;
    overflow: hidden;
  }
  @media (min-width: 900px) {
    .case-panel {
      width: clamp(28rem, 36vw, 40rem);
      min-height: 0;
      height: 100%;
      padding: 1.6rem 2.5rem 1.4rem 0;
      border-top: 0; border-left: 1px solid var(--line-2);
      padding-left: 2.5rem;
    }
    .case-panel:first-child { padding-left: 0; border-left: 0; }
  }
  .case-num {
    position: absolute; right: 0; top: -0.5rem;
    font-family: var(--font-mono); font-size: clamp(5rem, 10vw, 9rem); line-height: 1;
    color: transparent; -webkit-text-stroke: 1px var(--line); pointer-events: none;
  }
  /* Photo strip, cooled into the palette: desaturated, storm-tinted, edge-faded */
  .case-media { position: relative; height: clamp(5.5rem, 13vh, 9rem); overflow: hidden; -webkit-mask-image: linear-gradient(to bottom, black 70%, transparent); mask-image: linear-gradient(to bottom, black 70%, transparent); }
  .case-media img { width: 100%; height: 100%; object-fit: cover; display: block; filter: grayscale(0.7) contrast(1.05); transition: transform 1.2s var(--ease-out); }
  .case-media::after { content: ''; position: absolute; inset: 0; background: var(--deep); mix-blend-mode: color; opacity: 0.85; pointer-events: none; }
  .case-panel:hover .case-media img { transform: scale(1.04); }
  /* Hovering any panel reveals the captions on every panel in the row (Yasin) */
  .case-cap { position: absolute; left: 0; right: 0; top: 0; display: flex; justify-content: space-between; padding: 0.75rem 0.9rem; color: var(--ink); opacity: 0; transform: translateY(-6px); transition: opacity 0.5s var(--ease-out), transform 0.6s var(--ease-out); z-index: 2; }
  .case-cap span { white-space: nowrap; background: color-mix(in oklch, var(--bg) 70%, transparent); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); padding: 0.3rem 0.55rem; border-radius: 999px; }
  .work-track:hover .case-cap { opacity: 1; transform: none; }
  .case-panel { transition: transform 0.7s var(--ease-out); }
  /* cursor-following light (spotlight.js sets --sx/--sy) and a slow push-in on the artwork */
  .case-panel::after {
    content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none; opacity: 0; transition: opacity 0.5s var(--ease-out);
    background: radial-gradient(360px circle at var(--sx, 50%) var(--sy, 50%), color-mix(in oklch, var(--accent) 22%, transparent), transparent 70%);
  }
  .case-panel:hover::after { opacity: 1; }
  .case-panel > * { position: relative; z-index: 1; }
  .case-media img { transition: transform 1.2s var(--ease-out), filter 0.6s; }
  .case-panel:hover .case-media img { transform: scale(1.06); filter: saturate(1.15) brightness(1.08); }
  .work-track:hover .case-panel:not(:hover) { transform: translateY(6px); }
  .case-panel:hover { transform: translateY(-6px); }
  @media (pointer: coarse) { .case-cap { opacity: 1; transform: none; } .case-cap span + span { display: none; } .work-track:hover .case-panel:not(:hover), .case-panel:hover { transform: none; } }
  .case-top { display: grid; gap: 0.35rem; position: relative; z-index: 1; }
  .case-metric {
    font-family: var(--font-display); font-weight: 200;
    font-size: clamp(3.2rem, 6vw, 5.6rem); line-height: 1; letter-spacing: -0.03em; color: var(--ink);
  }
  .case-metric-label { color: var(--ink-3); }
  .case-mid { display: grid; gap: 1rem; align-content: start; }
  .case-mid :global(.fig) { max-width: 22rem; margin-top: 0.5rem; }
  .case-title { margin: 0; font-weight: 400; font-size: clamp(1.2rem, 1.7vw, 1.5rem); color: var(--ink); }
  .case-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .project-chip { border: 1px solid var(--line-2); border-radius: 999px; padding: 0.35rem 0.7rem; color: var(--ink-2); display: inline-flex; align-items: center; gap: 0.4rem; white-space: nowrap; max-width: 100%; }
  .project-chip--ai { color: var(--accent); border-color: color-mix(in oklch, var(--accent) 45%, transparent); }
  [data-tone="dark"] .project-chip--ai { color: oklch(0.90 0.06 225); } /* the accent is too dim on the storm tint for AA */
  .project-outcome { max-width: 30rem; }
  .case-foot { align-self: end; }

  .project-card--end { align-content: space-between; gap: 2rem; }
  @media (min-width: 900px) {
    /* the outro panel fills the rest of the screen, content centred, so the track never ends on a half-empty page */
    .project-card--end { width: min(46rem, calc(100vw - var(--gutter) * 2 - 6rem)); align-content: center; justify-items: center; text-align: center; gap: 2.5rem; border-left: 1px solid var(--line-2); }
    .project-card--end .end-label { font-size: clamp(3rem, 6vw, 6rem); }
  }
  .project-card--end .btn { justify-self: start; align-self: end; }
  @media (min-width: 900px) { .project-card--end.case-panel .btn { justify-self: center; align-self: center; } }
  .end-label { font-size: clamp(2rem, 3.6vw, 3.4rem); color: var(--ink-3); }
</style>
