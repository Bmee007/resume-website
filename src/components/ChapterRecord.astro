---
// ChapterRecord.astro — CH.04. The record: roles, then the spec sheet of capabilities.
const roles = [
  {
    year: "2023", range: "2023 — Present", title: "AI & Agent Systems Lead", company: "Kohl & Frisch", featured: true,
    bullets: [
      "Designed and deployed multi-step agentic workflows with custom skills and harness architecture, automating <em>16 operational processes</em> across finance and supply chain",
      "Built LLM-powered demand-forecasting agents on ERP supply-chain data: <em>13% forecast accuracy improvement</em>",
      "Shipped a Copilot Studio assistant handling <em>90% of tier-1 IT queries</em> for 2,400 staff; researching LLM memory and agent security (prompt injection, trust boundaries)",
    ],
  },
  {
    year: "2019", range: "2019 — 2023", title: "AI & ERP Integration Lead · Supply Chain Transformation", company: "Kohl & Frisch", featured: true,
    bullets: [
      "Directed the end-to-end Microsoft Dynamics 365 migration from IBM AS400, cutting operational costs by <em>30%</em>",
      "Integrated AI procurement agents into D365 workflows, reducing purchase cycle time by <em>33%</em>",
      "Led a <em>45-person</em> cross-functional team through an 18-month modernisation program",
    ],
  },
  {
    year: "2016", range: "2016 — 2019", title: "WMS & Operations AI Lead · Warehouse Intelligence", company: "Kohl & Frisch", featured: false,
    bullets: [
      "Deployed Manhattan DFIO alongside Dynamics 365 across <em>7 distribution centres</em>, integrating AI pick optimisation and increasing throughput by <em>15%</em>",
      "Applied ML-driven operations models to reduce labour costs by <em>5%</em> while improving pick accuracy to <em>99.7%</em>",
      "Partnered with the C-suite to align the warehouse AI roadmap with a five-year supply-chain and retail fulfilment strategy",
    ],
  },
];
const education = [
  { school: "University of Toronto", field: "Business Analysis" },
  { school: "Sheridan College", field: "Data Science · Data Modeling, Warehousing & Database Administration" },
  { school: "Centennial College School of Business", field: "Operations Management & Supervision" },
];
const spec = [
  { title: "ERP · WMS · TMS", skills: ["Microsoft Dynamics 365", "Manhattan DFIO", "TMS integration", "IBM AS400 · legacy migration"] },
  { title: "Agent engineering", skills: ["Agent harnesses & skills", "Multi-step workflows", "LLM memory (episodic · semantic · working)", "Agent security · prompt injection"] },
  { title: "AI / ML", skills: ["Azure OpenAI / Microsoft Copilot", "Claude · GPT-4o · Gemini", "Power Automate + AI Builder", "Custom ML / Python models"] },
  { title: "Leadership", skills: ["Team leadership", "Stakeholder management", "Change management", "ERP rollout strategy"] },
];
---
<section
  id="experience" class="chapter record"
  data-scene="clearing" data-tone="light" data-chapter="05" data-label="Record"
  data-lattice="ledger" data-lattice-tint="1.16,1.06,0.86" data-lattice-then-tint="0.86,1.12,1.0" data-lattice-cx="0.81" data-lattice-cy="0.3" data-lattice-scale="0.56" data-lattice-opacity="0.68" data-lattice-rx="0.72" data-lattice-ry="-0.35"
  data-lattice-gap data-lattice-then="pills" data-lattice-then-at="#skills" data-lattice-then-cx="0.885" data-lattice-then-cy="0.36" data-lattice-then-scale="0.3" data-lattice-then-rx="0.1" data-lattice-then-ry="-0.5"
>
  <span class="chapter-mark" aria-hidden="true">05</span>

  <div class="wrap">
    <p class="telemetry" data-scramble><span class="ch">CH.05</span> Record · Kohl &amp; Frisch, 2016 — present · earlier roles on request</p>
    <h2 class="t-display record-heading" data-split>The record.</h2>

    <ol class="timeline">
      {roles.map((r) => (
        <li class:list={["timeline-entry", r.featured && "is-featured"]} data-reveal>
          <span class="entry-rule" data-rule></span>
          <span class="entry-year">{r.year}</span>
          <div class="entry-body">
            <div class="entry-head">
              <h3 class="entry-title">{r.title}</h3>
              <span class="entry-meta t-mono"><strong>{r.company}</strong> · {r.range}</span>
            </div>
            <ul class="entry-bullets">
              {r.bullets.map((b) => <li set:html={b}></li>)}
            </ul>
          </div>
        </li>
      ))}
    </ol>

    <section id="education" class="edu" aria-label="Education">
      <div class="spec-head">
        <p class="telemetry" data-scramble><span class="ch">05.1</span> Education</p>
        <h3 class="t-display spec-heading" data-split>Where the foundation was laid</h3>
      </div>
      <ol class="edu-list" data-reveal>
        {education.map((e) => (
          <li class="edu-row">
            <span class="edu-rule" data-rule aria-hidden="true"></span>
            <span class="edu-school">{e.school}</span>
            <span class="edu-field t-mono">{e.field}</span>
          </li>
        ))}
      </ol>
    </section>

    <section id="skills" class="spec" aria-label="Skills and expertise">
      <!-- Phones: the pill bottle lives in this spacer (desktop gets it from the story-object director) -->
      <div class="obj-zone" data-zone-model="pills" data-zone-scale="0.8" data-zone-rx="0.1" data-zone-ry="-0.5" aria-hidden="true"></div>
      <div class="spec-head">
        <p class="telemetry" data-scramble><span class="ch">05.2</span> Spec sheet</p>
        <h3 class="t-display spec-heading" data-split>Skills &amp; expertise</h3>
      </div>
      <div class="spec-grid">
        {spec.map((col, i) => (
          <div class="spec-col" data-reveal>
            <span class="spec-num t-mono">0{i + 1}</span>
            <span class="spec-title">{col.title}</span>
            <div class="spec-chips">
              {col.skills.map((s) => <span class="skill-chip">{s}</span>)}
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</section>

<style>
  .record { padding-block: clamp(8rem, 16vw, 14rem) clamp(4rem, 7vw, 6rem); }
  .record-heading { font-size: clamp(2.6rem, 7vw, 7rem); margin-top: 1rem; }

  .timeline { list-style: none; margin: 3rem 0 0; padding: 0; display: grid; }
  .timeline-entry {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    padding: 2.25rem 0;
  }
  .entry-rule { position: absolute; top: 0; left: 0; right: 0; height: 1px; background: var(--line-2); }
  .timeline-entry:last-child::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 1px; background: var(--line-2); }
  .entry-year {
    font-family: var(--font-display); font-weight: 200;
    font-size: clamp(2.6rem, 6vw, 5.5rem); line-height: 0.9; letter-spacing: -0.03em;
    color: var(--ink-3); transition: color 0.5s var(--ease-out);
  }
  .is-featured .entry-year { color: var(--ink); }
  .timeline-entry:hover .entry-year { color: var(--accent); }
  .entry-body { display: grid; gap: 1.25rem; }
  .entry-head { display: grid; gap: 0.4rem; }
  .entry-title { margin: 0; font-weight: 400; font-size: clamp(1.15rem, 1.6vw, 1.45rem); color: var(--ink); letter-spacing: 0.01em; }
  .entry-meta { color: var(--ink-3); }
  .entry-bullets { margin: 0; padding-left: 1.1rem; display: grid; gap: 0.5rem; max-width: 46rem; }
  .entry-bullets li { color: var(--ink-2); line-height: 1.65; font-size: 0.95rem; }
  .entry-bullets li :global(em) { font-style: normal; color: var(--ink); font-weight: 500; }

  @media (min-width: 900px) {
    .timeline-entry { grid-template-columns: 3fr 9fr; gap: 2rem; }
  }

  /* Education */
  .edu { margin-top: clamp(5rem, 10vw, 9rem); }
  .edu-list { list-style: none; margin: 2.5rem 0 0; padding: 0; display: grid; }
  .edu-row { position: relative; display: grid; grid-template-columns: 1fr; gap: 0.35rem; padding: 1.4rem 0; }
  .edu-rule { position: absolute; top: 0; left: 0; right: 0; height: 1px; background: var(--line-2); }
  .edu-row:last-child::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 1px; background: var(--line-2); }
  .edu-school { font-size: clamp(1.1rem, 1.6vw, 1.4rem); color: var(--ink); font-weight: 400; }
  .edu-field { color: var(--ink-3); text-transform: none; letter-spacing: 0.04em; }
  @media (min-width: 900px) { .edu-row { grid-template-columns: 5fr 7fr; gap: 2rem; align-items: baseline; } }

  /* Spec sheet */
  .spec { margin-top: clamp(5rem, 10vw, 9rem); }
  .obj-zone { display: none; }
  @media (max-width: 899px) { .obj-zone { display: block; height: min(46vh, 22rem); margin-bottom: 1rem; } }
  .spec-head { display: grid; gap: 1rem; }
  .spec-heading { font-size: clamp(1.8rem, 3.4vw, 3rem); }
  .spec-grid {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--line-2);
  }
  @media (min-width: 700px) { .spec-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .spec-grid { grid-template-columns: repeat(4, 1fr); padding-right: clamp(0px, 13vw, 200px); } } /* gutter for the pill bottle */
  .spec-col {
    display: grid; align-content: start; gap: 0.75rem;
    padding: 1.75rem 1.5rem 2rem 0;
    border-bottom: 1px solid var(--line-2);
  }
  @media (min-width: 1100px) { .spec-col + .spec-col { padding-left: 1.5rem; border-left: 1px solid var(--line); } }
  .spec-num { color: var(--accent); }
  .spec-title { font-size: 0.8rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-3); }
  .spec-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.5rem; }
  .skill-chip {
    display: inline-block;
    font-size: 0.875rem; color: var(--ink-2);
    border: 1px solid var(--line-2); border-radius: 999px;
    padding: 0.45rem 0.9rem;
    transition: color 0.3s, border-color 0.3s, transform 0.4s var(--ease-out);
  }
  .skill-chip:hover { color: var(--ink); border-color: var(--ink); transform: translateY(-2px); }
  /* hover or focus a chip: its column lights, the others quiet down */
  .spec-grid:has(.skill-chip:hover) .spec-col:not(:has(.skill-chip:hover)),
  .spec-grid:has(.skill-chip:focus-visible) .spec-col:not(:has(.skill-chip:focus-visible)) { opacity: 0.38; }
  .spec-col { transition: opacity 0.45s var(--ease-out); position: relative; }
  .spec-col::before, .timeline-entry::before {
    content: ''; position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity 0.5s var(--ease-out);
    background: radial-gradient(280px circle at var(--sx, 50%) var(--sy, 50%), color-mix(in oklch, var(--accent) 14%, transparent), transparent 70%);
  }
  .spec-col:hover::before, .timeline-entry:hover::before { opacity: 1; }
  .timeline-entry { position: relative; }
</style>
