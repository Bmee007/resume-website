---
// CustomCursor.astro — survey crosshair. Dot snaps, ring trails, difference blend keeps it visible on any fog.
---
<div id="custom-cursor" aria-hidden="true">
  <span class="c-tick c-tick--n"></span><span class="c-tick c-tick--s"></span>
  <span class="c-tick c-tick--e"></span><span class="c-tick c-tick--w"></span>
  <span class="c-glyph" aria-hidden="true">↗</span>
  <span class="c-label" aria-hidden="true">Drag</span>
</div>
<div id="custom-cursor-dot" aria-hidden="true"></div>

<style>
  #custom-cursor, #custom-cursor-dot {
    position: fixed; top: 0; left: 0;
    pointer-events: none;
    mix-blend-mode: difference;
    opacity: 0;
    will-change: transform;
  }
  #custom-cursor {
    width: 36px; height: 36px;
    border: 1px solid white;
    border-radius: 50%;
    z-index: 9998;
    transition: width 0.4s var(--ease-out), height 0.4s var(--ease-out), opacity 0.4s, background 0.4s;
  }
  #custom-cursor-dot { width: 4px; height: 4px; background: white; z-index: 9999; transition: opacity 0.4s; }
  .c-tick { position: absolute; background: white; }
  .c-tick--n, .c-tick--s { width: 1px; height: 6px; left: 50%; }
  .c-tick--e, .c-tick--w { height: 1px; width: 6px; top: 50%; }
  .c-tick--n { top: -8px; } .c-tick--s { bottom: -8px; } .c-tick--e { right: -8px; } .c-tick--w { left: -8px; }
  #custom-cursor.is-hovering { width: 64px; height: 64px; background: rgba(255,255,255,0.12); }
  #custom-cursor.is-hovering .c-tick { opacity: 0; }
  .c-glyph { position: absolute; inset: 0; display: grid; place-items: center; font-family: var(--font-mono); font-size: 14px; color: white; opacity: 0; transition: opacity 0.25s; }
  #custom-cursor.is-open .c-glyph { opacity: 1; }
  #custom-cursor.is-open { width: 56px; height: 56px; background: rgba(255,255,255,0.1); }
  .c-label { position: absolute; inset: 0; display: grid; place-items: center; font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.16em; text-transform: uppercase; color: white; opacity: 0; transition: opacity 0.25s; }
  body.can-drag #custom-cursor { width: 72px; height: 72px; background: rgba(255,255,255,0.08); }
  body.can-drag #custom-cursor .c-tick { opacity: 0; }
  body.can-drag #custom-cursor .c-label { opacity: 1; }
  body.is-dragging #custom-cursor { width: 44px; height: 44px; background: rgba(255,255,255,0.18); }
  body.is-dragging #custom-cursor .c-label { opacity: 0; }
  body.is-dragging { user-select: none; }
  body.cursor-ready #custom-cursor, body.cursor-ready #custom-cursor-dot { opacity: 1; }
</style>

<script>
  const fine = window.matchMedia('(pointer: fine)').matches;
  const ring = document.getElementById('custom-cursor');
  const dot = document.getElementById('custom-cursor-dot');
  if (!fine) { ring?.remove(); dot?.remove(); }
  else if (ring && dot) {
    let mx = innerWidth / 2, my = innerHeight / 2, rx = mx, ry = my, armed = false;
    document.addEventListener('mousemove', (e) => {
      mx = e.clientX; my = e.clientY;
      dot.style.transform = `translate(${mx - 2}px, ${my - 2}px)`;
      if (!armed) { armed = true; document.body.classList.add('cursor-ready'); }
    }, { passive: true });
    const loop = () => {
      rx += (mx - rx) * 0.16; ry += (my - ry) * 0.16;
      const s = ring.offsetWidth / 2;
      ring.style.transform = `translate(${rx - s}px, ${ry - s}px)`;
      requestAnimationFrame(loop);
    };
    loop();
    const sel = 'a, button, [data-cursor-hover], input, textarea, label';
    document.addEventListener('mouseover', (e) => { const t = (e.target as Element).closest(sel); if (t) { ring.classList.add('is-hovering'); if ((t as HTMLElement).dataset.cursor === 'open' || (t as HTMLAnchorElement).target === '_blank') ring.classList.add('is-open'); } });
    document.addEventListener('mouseout',  (e) => { if ((e.target as Element).closest(sel)) ring.classList.remove('is-hovering', 'is-open'); });
    document.addEventListener('mouseleave', () => { ring.style.opacity = '0'; dot.style.opacity = '0'; });
    document.addEventListener('mouseenter', () => { ring.style.opacity = ''; dot.style.opacity = ''; });
  }
</script>
