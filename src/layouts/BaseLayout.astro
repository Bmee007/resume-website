---
import "../styles/global.css";
import Backdrop from "../components/Backdrop.astro";
import Loader from "../components/Loader.astro";
import Nav from "../components/Nav.astro";
import CustomCursor from "../components/CustomCursor.astro";

interface Props {
  title: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  canonicalUrl?: string;
  showLoader?: boolean;
}

const {
  title,
  description = "Borina Keo — AI Systems Engineer and Agent Builder. 15+ years of ERP, WMS and TMS transformation across supply chain, healthcare and retail, now building the agents that run on top of them.",
  ogTitle = title,
  ogDescription = description,
  ogImage = "/og-image.png",
  canonicalUrl = Astro.url.href,
  showLoader = true,
} = Astro.props;

const siteBase = Astro.site ?? new URL(Astro.request.url).origin;
const ogImageAbsolute = new URL(ogImage, siteBase).href;

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Borina Keo",
  jobTitle: "AI Systems Engineer · Agent Builder · Supply Chain AI",
  url: siteBase,
  sameAs: ["https://www.linkedin.com/in/borinakeo", "https://github.com/Bmee007"],
  description: "AI systems engineer and agent builder grounded in 15+ years of ERP, WMS and TMS transformation across supply chain, healthcare and retail operations.",
};
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#e3e8ee" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    {showLoader && <Loader />}
    <Backdrop />
    <CustomCursor />
    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>

    <script>
      import { boot } from '../scripts/main.js';
      boot();
    </script>
  </body>
</html>
